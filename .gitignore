# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.pytest_cache/
.ruff_cache/

# Django
staticfiles/
media/
db.sqlite3
*.log
celerybeat-schedule*

# Local TLS certs (mkcert), generated per machine
certs/

# Migrations are generated per environment (run makemigrations after cloning)
**/migrations/**
!**/migrations/__init__.py

# Secrets: only the templates are committed
.env
**/.env
!.env.example
!**/.env.example

# Editors / OS
.idea/
.vscode/
.DS_Store
.claude/settings.local.json
