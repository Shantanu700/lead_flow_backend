# Copy to .env (dev). Django reads it directly; no container restart on change.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DATABASE_URL=postgres://leadflow:<password>@postgres_db:5432/leadflow_dev
REDIS_URL=redis://redis:6379/2
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://localhost:3000
CSRF_TRUSTED_ORIGINS=https://localhost:3000
