# Copy to .env (dev). Django reads it directly; no container restart on change.
# The hosts below are the dev compose's own postgres and redis services.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
# The app's own role and database; create_database makes them on first start.
DATABASE_URL=postgres://leadflow:leadflow@postgres:5432/leadflow_dev
# A superuser login, used only by create_database (matches the compose defaults).
DATABASE_ADMIN_URL=postgres://postgres:postgres@postgres:5432/postgres
REDIS_URL=redis://redis:6379/0
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://localhost:3000
CSRF_TRUSTED_ORIGINS=https://localhost:3000
# Optional: the demo login's password. Left empty, seed_fixtures makes one up
# and prints it in the web container's log (docker logs leadflow_dev_web).
DEMO_PASSWORD=
