# Copy to docker/prod/.env. Injected by compose; re-run "up -d" after edits.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DATABASE_URL=postgres://leadflow:<password>@postgres_db:5432/leadflow_prod
REDIS_URL=redis://redis:6379/3
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
